---
import { Image } from "astro:assets";
import dragonSrc from "../assets/dragon-hero.png";
---
<section class="relative min-h-[100vh] w-full overflow-hidden bg-[#05070a] flex flex-col">
  <!-- dragon background -->
  <div class="absolute inset-0">
    <Image
      src={dragonSrc}
      alt="Draconis dragon — Chinese dragon illustration"
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      formats={["webp", "avif"]}
      loading="eager"
      fetchpriority="high"
      class="w-full h-full object-cover object-[58%_18%] lg:object-[center_20%] scale-[1.02]"
    />
    <!-- cinematic washes -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#05070a]/55 via-transparent to-[#05070a]"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#05070a]/85 via-[#05070a]/35 to-transparent lg:via-[#05070a]/15"></div>
    <div class="absolute inset-0 bg-[#05070a]/10 mix-blend-soft-light"></div>
    <!-- v1.0 cheap smoke / fog drift layers -->
    <div class="absolute inset-0 opacity-[0.18] pointer-events-none" style="background: radial-gradient(ellipse 900px 400px at 70% 78%, rgba(255,255,255,0.22), transparent 65%), radial-gradient(ellipse 600px 300px at 20% 85%, rgba(201,168,106,0.12), transparent 60%); filter: blur(18px); animation: drift 24s ease-in-out infinite alternate;"></div>
    <!-- vignette -->
    <div class="absolute inset-0" style="box-shadow: inset 0 0 220px rgba(0,0,0,0.85), inset 0 0 80px rgba(0,0,0,0.6)"></div>
    <!-- grid HUD faint -->
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(rgba(255,255,255,0.6) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.6) 1px, transparent 1px); background-size: 120px 120px;"></div>
  </div>

  <!-- left coordinates hud -->
  <div class="absolute hidden lg:block left-6 xl:left-8 top-[112px] z-10">
    <div class="w-[1px] h-[140px] bg-white/20 absolute left-0 top-0"></div>
    <div class="w-[70px] h-[1px] bg-white/20 absolute left-0 top-0"></div>
    <div class="absolute left-3 top-3 font-mono text-[9px] leading-[1.6] tracking-[0.14em] text-white/35">
      <div>60.3913° N</div>
      <div>5.3221° E</div>
    </div>
    <div class="absolute -left-[3px] top-[140px] w-[7px] h-[7px] border-l border-b border-white/20"></div>
  </div>

  <!-- right pillar hud -->
  <div class="absolute hidden lg:flex right-6 xl:right-8 top-[98px] bottom-[220px] z-10 flex-col items-end pointer-events-none">
    <div class="w-[1.5px] h-10 bg-[#c9a86a]/70"></div>
    <div class="mt-3 text-right font-mono text-[8px] tracking-[0.18em] leading-[1.9] text-white/30">
      <div>INNOVATION</div>
      <div>PERFORMANCE</div>
      <div>OPEN SOURCE</div>
      <div>COMMUNITY</div>
    </div>
    <div class="flex-1 w-[1px] bg-white/10 mt-4 min-h-[80px]"></div>
    <!-- crosshair -->
    <div class="relative w-10 h-10 mt-6 opacity-30">
      <div class="absolute left-1/2 top-0 bottom-0 w-[1px] bg-white/30 -translate-x-1/2"></div>
      <div class="absolute top-1/2 left-0 right-0 h-[1px] bg-white/30 -translate-y-1/2"></div>
      <div class="absolute left-1/2 top-1/2 w-3 h-3 -translate-x-1/2 -translate-y-1/2 border border-white/20 rounded-full"></div>
    </div>
    <div class="mt-auto flex flex-col items-center">
      <div class="text-[28px] leading-none text-white/90 font-light" style="writing-mode: vertical-rl; letter-spacing: 0.3em;">龍</div>
      <div class="text-[7px] tracking-[0.35em] text-white/25 font-mono mt-2" style="writing-mode: vertical-rl;">DRACONIS</div>
    </div>
  </div>

  <!-- center horizontal line hud -->
  <div class="absolute hidden lg:block left-[52%] right-[8%] top-[142px] h-[1px] bg-white/[0.06] z-10"></div>

  <!-- hero content -->
  <div class="relative z-20 max-w-[1480px] mx-auto w-full px-6 lg:px-8 flex-1 flex flex-col justify-center pt-[88px] pb-[200px] lg:pb-[220px]">
    <div class="max-w-[560px] mt-10 lg:mt-16">
      <!-- eyebrow -->
      <div class="flex items-center gap-3">
        <span class="w-10 h-[1.5px] bg-[#c9a86a]"></span>
        <span class="text-[10px] tracking-[0.22em] font-mono text-[#c9a86a]/90">DRACONIS ENGINEERING</span>
      </div>

      <h1 class="mt-6 text-[30px] sm:text-[36px] lg:text-[42px] font-light leading-[0.95] tracking-[0.08em] text-white">
        ENGINEERING<br />
        <span class="text-white/90">SOFTWARE FOR A</span><br />
        <span class="text-[#c9a86a] font-normal tracking-[0.10em]">HIGHER STANDARD.</span>
      </h1>

      <p class="mt-6 max-w-[420px] text-[11.5px] leading-[1.9] tracking-[0.02em] text-white/55 font-mono">
        We build open-source software and tools for athletes, engineers and thinkers who want to push the limits — in every direction.
      </p>

      <a href="/projects" class="group mt-8 inline-flex items-center gap-5 text-[10px] tracking-[0.22em] font-mono text-white/80 hover:text-white transition">
        <span class="border-b border-white/15 pb-1 group-hover:border-[#c9a86a]/60">EXPLORE THE ECOSYSTEM</span>
        <span class="relative flex items-center">
          <span class="w-14 h-[1px] bg-[#c9a86a] group-hover:w-16 transition-all"></span>
          <span class="w-2 h-2 border-r border-t border-[#c9a86a] rotate-45 -ml-[6px]"></span>
        </span>
      </a>

      <!-- faint line below CTA -->
      <div class="mt-10 w-full max-w-[420px] h-[1px] bg-gradient-to-r from-white/10 to-transparent"></div>
    </div>
  </div>

  <!-- bottom project strip — overlaps hero bottom -->
  <div class="relative z-20 w-full mt-auto">
    <div class="max-w-[1480px] mx-auto px-6 lg:px-8 pb-6 lg:pb-8">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr_1fr_260px] gap-3 items-end">
        <!-- cards injected via slot or passed? We'll render them as separate component but provide fallback placeholders here for layout preview -->
        <slot name="cards" />
      </div>
    </div>
  </div>

  <style>
    @keyframes drift {
      0% { transform: translateX(0) translateY(0); }
      100% { transform: translateX(-18px) translateY(-10px); }
    }
  </style>
</section>
