      <div class="flex items-center gap-3">
        <svg viewBox="0 0 32 32" class="w-6 h-6 opacity-70" fill="none" aria-hidden="true"><path d="M6 6 L14 6 L20 12 L14 16 L20 20 L14 26 L6 26 Z" stroke="white" stroke-width="1.5" fill="none"/><path d="M14 6 L20 2 L28 10 L22 16 L28 22 L20 30 L14 26" stroke="white" stroke-width="1.5" fill="none"/></svg>
        <span class="text-[11px] tracking-[0.2em] text-white/40 font-mono">© {new Date().getFullYear()} DRACONIS ENGINEERING — BUILT IN THE OPEN</span>
      </div>
      <div class="flex items-center gap-6 text-[11px] tracking-[0.12em] font-mono text-white/45">
        <a href="https://github.com" class="hover:text-white transition inline-flex items-center gap-2"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.84 10.92c.58.1.79-.25.79-.56v-2.02c-3.19.69-3.86-1.35-3.86-1.35-.52-1.33-1.27-1.68-1.27-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.75 2.67 1.25 3.32.95.1-.74.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.06 11.06 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg> GitHub</a>
        <a href="/docs" class="hover:text-white transition inline-flex items-center gap-2"><BookOpen size={14} /> Documentation</a>
        <a href="/about" class="hover:text-white transition inline-flex items-center gap-2"><Users size={14} /> Community</a>
