---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---
<BaseLayout title="Docs — Draconis Engineering">
  <Header />
  <main class="pt-[88px] bg-[#070a0c] min-h-[70vh]">
    <div class="max-w-[1480px] mx-auto px-6 lg:px-8 py-12">
      <div class="flex items-center gap-3"><span class="w-8 h-[1px] bg-[#c9a86a]"></span><span class="text-[10px] tracking-[0.22em] font-mono text-[#c9a86a]">DOCS</span></div>
      <h1 class="mt-4 text-[28px] lg:text-[36px] tracking-[0.08em] font-light text-white">DOCUMENTATION</h1>
      <p class="mt-3 max-w-[560px] text-[11.5px] leading-[1.8] font-mono text-white/45">Docs are Markdown/MDX — GitHub repo is source of truth. This is a stub for MVP; full docs land in v1.1.</p>
      <div class="mt-8 grid lg:grid-cols-[220px_1fr] gap-6">
        <nav class="space-y-1 text-[11px] font-mono">
          <div class="text-white/25 tracking-[0.18em] text-[9px] mb-3">SECTIONS</div>
          <a class="block py-2 px-3 bg-white/5 text-white border-l border-[#c9a86a]">Getting Started</a>
          <a class="block py-2 px-3 text-white/40 hover:text-white/70 hover:bg-white/[0.02]">Olympus</a>
          <a class="block py-2 px-3 text-white/40 hover:text-white/70 hover:bg-white/[0.02]">Dracolix</a>
          <a class="block py-2 px-3 text-white/40 hover:text-white/70 hover:bg-white/[0.02]">Icarus</a>
        </nav>
        <div class="prose prose-invert max-w-none p-6 border border-white/10 bg-white/[0.02]">
          <h2 class="text-[13px] tracking-[0.16em] font-mono text-white/80">GETTING STARTED (PLACEHOLDER)</h2>
          <p class="text-[13px] leading-relaxed text-white/55 mt-3">This page will render MDX from <code class="text-[#c9a86a]">src/content/docs/</code>. Add a file like <code>getting-started.mdx</code> and it appears here. GitHub Actions will keep it in sync.</p>
          <pre class="mt-4 bg-black/40 p-4 text-[11px] font-mono text-white/60 overflow-auto">src/content/docs/getting-started.mdx
---
title: Getting Started
---
# Getting Started
Install, configure, run.</pre>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
