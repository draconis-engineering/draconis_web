---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allDocs = (await getCollection("docs")).sort((a,b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---
<BaseLayout title={`${entry.data.title} — Draconis Docs`} description={entry.data.description}>
  <Header />
  <main class="pt-[88px] bg-[#070a0c] min-h-[70vh]">
    <div class="max-w-[1480px] mx-auto px-6 lg:px-8 py-12">
      <div class="grid lg:grid-cols-[220px_1fr] gap-8">
        <!-- sidebar -->
        <aside class="hidden lg:block">
          <div class="sticky top-24">
            <div class="text-[9px] tracking-[0.22em] font-mono text-white/25 mb-3">DOCS</div>
            <nav class="space-y-0.5 border-l border-white/10 pl-3">
              {allDocs.map((d) => {
                const active = d.id === entry.id;
                return (
                  <a href={`/docs/${d.id}`} class={`block py-2 text-[11px] font-mono tracking-[0.04em] border-l -ml-[13px] pl-3 transition ${active ? "text-white border-[#c9a86a] bg-white/[0.04]" : "text-white/45 hover:text-white/75 border-transparent hover:border-white/15"}`}>
                    {d.data.title}
                  </a>
                );
              })}
            </nav>
            <a href="/docs" class="inline-flex mt-6 text-[10px] tracking-[0.16em] font-mono text-white/30 hover:text-white">← All docs</a>
          </div>
        </aside>

        <!-- content -->
        <article class="min-w-0">
          <div class="flex items-center gap-3">
            <span class="w-8 h-[1px] bg-[#c9a86a]"></span>
            <span class="text-[10px] tracking-[0.22em] font-mono text-[#c9a86a]">{entry.data.tag ?? "DOCS"}</span>
          </div>
          <h1 class="mt-3 text-[28px] lg:text-[34px] font-light tracking-[0.06em] text-white">{entry.data.title}</h1>
          {entry.data.description && <p class="mt-2 text-[12.5px] leading-[1.7] font-mono text-white/45 max-w-[720px]">{entry.data.description}</p>}
          <div class="mt-8 prose prose-invert prose-sm max-w-none prose-headings:tracking-[0.04em] prose-headings:font-light prose-a:text-[#c9a86a] prose-a:no-underline hover:prose-a:underline prose-code:text-[#e8d5a8] prose-code:bg-white/[0.06] prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-pre:bg-[#0a0f14] prose-pre:border prose-pre:border-white/10">
            <div class="bg-white/[0.02] border border-white/10 p-6 lg:p-8 rounded-sm">
              <Content />
            </div>
          </div>
        </article>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .prose h1 { font-size: 1.5em; margin-top: 0; }
  .prose h2 { font-size: 1.25em; margin-top: 2em; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 0.35em; }
  .prose pre { overflow-x: auto; }
</style>
