---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.tsx";
import { BookOpen, Users } from "lucide-react";
---
<BaseLayout>
  <div class="relative">
    <Header />
    <Hero>
      <div slot="cards" class="contents">
        <!-- main 3 featured exactly like concept -->
        <ProjectCard client:visible title="OLYMPUS" subtitle={"Performance System\nfor Athletes"} accent="gold" href="/projects#olympus" />
        <ProjectCard client:visible title="DRACOLIX" subtitle={"HPC / Math Platform"} accent="blue" href="/projects#dracolix" />
        <ProjectCard client:visible title="ICARUS" subtitle={"AI Agent\n& Productivity"} accent="red" href="/projects#icarus" />
        <!-- built in open -->
        <div class="hidden lg:flex flex-col justify-end pb-2 pl-6">
          <div class="text-[9px] tracking-[0.22em] font-mono text-white/35">BUILT IN THE OPEN</div>
          <div class="mt-3 h-[1px] bg-white/10"></div>
          <div class="mt-3 flex items-center gap-5 text-[10px] font-mono tracking-[0.08em] text-white/45">
            <a href="https://github.com/draconis-engineering" target="_blank" rel="noopener" class="hover:text-white transition inline-flex items-center gap-1.5"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.84 10.92c.58.1.79-.25.79-.56v-2.02c-3.19.69-3.86-1.35-3.86-1.35-.52-1.33-1.27-1.68-1.27-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.75 2.67 1.25 3.32.95.1-.74.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.06 11.06 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg> GitHub</a>
            <a href="/docs" class="hover:text-white transition inline-flex items-center gap-1.5"><BookOpen size={13} /> Documentation</a>
            <a href="/about" class="hover:text-white transition inline-flex items-center gap-1.5"><Users size={13} /> Community</a>
          </div>
        </div>
      </div>
    </Hero>

    <!-- below fold: full ecosystem preview -->
    <section class="bg-[#070a0c] border-t border-white/[0.06] relative">
      <div class="max-w-[1480px] mx-auto px-6 lg:px-8 py-12 lg:py-16">
        <div class="flex items-center gap-3">
          <span class="w-8 h-[1px] bg-[#c9a86a]"></span>
          <span class="text-[10px] tracking-[0.22em] font-mono text-white/40">THE ECOSYSTEM</span>
          <span class="flex-1 h-[1px] bg-white/5 ml-4"></span>
        </div>

        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          <ProjectCard client:visible title="OLYMPUS" subtitle="Performance System for Athletes — flagship" accent="gold" href="/projects#olympus" status="FLAGSHIP" />
          <ProjectCard client:visible title="DRAGONQUANT" subtitle="Quant / Trading Platform" accent="emerald" href="/projects#dragonquant" status="ACTIVE" />
          <ProjectCard client:visible title="DRACONOMICON" subtitle="Knowledge / Second Brain" accent="violet" href="/projects#draconomicon" status="ACTIVE" />
          <ProjectCard client:visible title="DURAPY" subtitle="Durable Python / Runtime" accent="cyan" href="/projects#durapy" status="ACTIVE" />
          <ProjectCard client:visible title="ICARUS" subtitle="AI Agent & Productivity" accent="red" href="/projects#icarus" status="ACTIVE" />
          <ProjectCard client:visible title="DRACONIFORGE" subtitle="Build & Tooling Platform" accent="blue" href="/projects#draconiforge" status="INCUBATOR" />
        </div>

        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/projects" class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#c9a86a] text-black text-[11px] tracking-[0.16em] font-mono font-medium hover:bg-[#d8bc8a] transition">VIEW ALL PROJECTS →</a>
          <a href="/docs" class="inline-flex items-center gap-2 px-5 py-2.5 border border-white/15 text-white/70 text-[11px] tracking-[0.16em] font-mono hover:border-white/30 hover:text-white transition">READ THE DOCS</a>
        </div>
      </div>
    </section>

    <Footer />
  </div>
</BaseLayout>
