---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const { 
  title = "Draconis Engineering — Engineering Software for a Higher Standard",
  description = "We build open-source software and tools for athletes, engineers and thinkers who want to push the limits — in every direction."
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#070a0c" />
    <meta name="robots" content="index, follow" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/dragon-hero.png", Astro.site ?? "https://draconis-engineering.com").href} />
    <meta property="og:site_name" content="Draconis Engineering" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/dragon-hero.png", Astro.site ?? "https://draconis-engineering.com").href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col bg-[#070a0c] text-zinc-100 selection:bg-[#c9a86a]/30">
    <slot />
  </body>
</html>
